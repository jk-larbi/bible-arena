# BIBLEARENA — Supabase Configuration
#
# Obtain these values from your Supabase Project Dashboard:
# 1. Project URL: Settings -> API -> Project URL
# 2. Public Anon Key: Settings -> API -> Project API keys -> 'anon' / 'public'
#
# IMPORTANT: Use the public/anon key only. NEVER paste the 'service_role' key here.

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-anon-key-here
